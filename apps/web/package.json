{
  "name": "@vastunord/web",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node --experimental-strip-types scripts/verify-production-target.mjs && node --experimental-strip-types scripts/verify-testing.mjs && prisma generate && next build",
    "build:webpack": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:newsletter-db": "node --experimental-strip-types --test tests/newsletter-postgres.mjs",
    "test:consent-db": "node --experimental-strip-types --test tests/publication-consent-postgres.mjs",
    "test:provider-db": "node --conditions=react-server --experimental-strip-types --test tests/studio-postgres.mjs",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.27",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vastunord/contracts": "workspace:*",
    "@vercel/blob": "2.9.0",
    "better-auth": "1.7.27",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "type": "module"
}
