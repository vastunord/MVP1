# Phase 02D templates only. Use separate Vastu Nord-owned development/preview/production values.
APP_ENV=development
DATABASE_URL=
DIRECT_DATABASE_URL=
BLOB_STORE_ID=
# Scoped private Blob credential; server-side only. Never use NEXT_PUBLIC_ for this value.
BLOB_READ_WRITE_TOKEN=
MEDIA_UPLOADS_ENABLED=false
# Authentication remains unavailable until DB, signing key and verified email sender exist.
BETTER_AUTH_SECRET=
# Required as HTTPS public origin in production; development uses localhost origin.
BETTER_AUTH_URL=
AUTH_EMAIL_PROVIDER=
AUTH_EMAIL_FROM=
RESEND_API_KEY=
# Optional; owner must explicitly enable after verifying the Vastu Nord OAuth client.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
