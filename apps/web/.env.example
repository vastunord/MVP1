# Phase 02B runs without credentials. Integrations cannot be enabled in this phase.
# Phase 02C templates only: values must come from separate Vastu Nord resources.
APP_ENV=development
DATABASE_URL=
DIRECT_DATABASE_URL=
BLOB_STORE_ID=
# Scoped private Blob credential; server-side only. Never use NEXT_PUBLIC_ for this value.
BLOB_READ_WRITE_TOKEN=
MEDIA_UPLOADS_ENABLED=false
