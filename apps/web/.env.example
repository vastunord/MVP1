# Phase 02D templates only. Use separate Vastu Nord-owned development/preview/production values.
APP_ENV=development
DATABASE_URL=
DIRECT_DATABASE_URL=
BLOB_STORE_ID=
# Vercel development connection supplies short-lived VERCEL_OIDC_TOKEN automatically.
# Optional local fallback only; server-side, never NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=
MEDIA_UPLOADS_ENABLED=false
# Optional guarded Development/Preview cleanup; never enable in Production.
MEDIA_RECONCILIATION_ENABLED=false
MEDIA_RECONCILIATION_SECRET=
# Authentication remains unavailable until DB, signing key and verified email sender exist.
# Production authentication additionally requires explicit AUTH_ENABLED=true after verification.
AUTH_ENABLED=false
BETTER_AUTH_SECRET=
# Production uses an HTTPS BETTER_AUTH_URL; development uses its local origin.
# Preview derives its exact HTTPS origin from VERCEL_URL supplied by Vercel.
BETTER_AUTH_URL=
AUTH_EMAIL_PROVIDER=
AUTH_EMAIL_FROM=
RESEND_API_KEY=
# Review the newsletter migration and delivery before activation in each environment.
NEWSLETTER_ENABLED=false
# Dedicated, stable, random (at least 32 characters). Signs opt-in and unsubscribe links.
NEWSLETTER_TOKEN_SECRET=
# Optional; owner must explicitly enable after verifying the Vastu Nord OAuth client.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Web Service ID and team-signed ES256 client-secret JWT.
# Register an exact HTTPS callback and rotate the JWT before its Apple expiry.
APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Vastu Nord provider secrets belong in protected server-side settings.
# Provider dashboards control usage budgets. These server-side keys serve Prana and Studio.
GroqAPI=
PRANA_FILM_VIDEO_ID=
# Optional read-only origin for the dedicated published editorial journal.
VASTUNORD_CMS_PUBLIC_ORIGIN=
MNMLAPI=
# Enable indexing only at commercial release after content and rights review.
PUBLIC_INDEXING_ENABLED=false
COMMERCIAL_LAUNCH_APPROVED=false
